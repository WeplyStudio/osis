
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IZINKAN AKSES PUBLIK PENUH UNTUK SEMUA KOLEKSI AGAR DATA PASTI TERSIMPAN
    // Penting: Gunakan aturan ini hanya saat pengembangan untuk memastikan koneksi database berhasil.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
